# Copy to .env and fill in real values. Never commit .env.

# Prisma Postgres / PostgreSQL connection string (read by prisma.config.ts and the app)
prismadb_connector=

# OCI Object Storage (S3-compatible API)
OCI_object_endpoint=https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
access_key_id=
secret_access_key=
bucket_name=
# Optional: defaults to 604800 (7 days, the SigV4 maximum)
# OCI_SIGNED_URL_EXPIRES_IN=604800

# Auth
JWT_SECRET_KEY=
JWT_EXPIRATION=1h

# Server / Traefik (used by docker-compose.yml)
PORT=3000
DOMAIN=
